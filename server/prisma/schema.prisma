generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Workspace {
  id String @id @default(cuid())

  slackTeamId String @unique
  slackTeamName String
  botToken String
  botUserId String
  installedBySlackUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels Channel[]
  users User[]

  @@index([slackTeamId])
}

model Channel {
  id String @id @default(cuid())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slackChannelId String
  name String
  isPrivate Boolean
  isArchived Boolean @default(false)
  isMember Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  standupConfig StandupConfig?

  members ChannelMember[]

  @@unique([workspaceId, slackChannelId])
  @@index([workspaceId])
}

model User {
  id String @id @default(cuid())

  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slackUserId String
  slackUserName String
  displayName String
  timezone String?
  isBot Boolean @default(false)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels ChannelMember[]

  responses StandupResponse[]

  @@unique([workspaceId, slackUserId])
  @@index([workspaceId])
}

model ChannelMember {
  channelId String
  userId String

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@id([channelId, userId])
  @@index([userId])
}

model StandupConfig {
  id String @id @default(cuid())

  channelId String @unique
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  standupHour Int
  standupMinute Int
  timezone String
  reminderMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions StandupQuestion[]
  sessions StandupSession[]
}

model StandupQuestion {
  id String @id @default(cuid())

  standupConfigId String
  standupConfig StandupConfig @relation(fields: [standupConfigId], references: [id], onDelete: Cascade)

  question String
  order Int @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]

  @@index([standupConfigId])
  @@unique([standupConfigId, order])
}

model StandupSession {
  id String @id @default(cuid())

  standupConfigId String
  standupConfig StandupConfig @relation(fields: [standupConfigId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  status SessionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses StandupResponse[]
  summary StandupSummary?

  @@unique([standupConfigId, scheduledDate])
  @@index([scheduledDate])
}

model StandupResponse {
  id String @id @default(cuid())

  sessionId String
  session StandupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers Answer[]

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Answer {
  id String @id @default(cuid())

  responseId String
  response StandupResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId String
  question StandupQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answer String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responseId])
  @@index([questionId])
}

model StandupSummary {
  id String @id @default(cuid())

  sessionId String @unique
  session StandupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  content String

  generatedAt DateTime @default(now())
}